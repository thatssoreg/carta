{
  "appName": "CARTA Atlas",
  "basemap": {
    "styleUrl": "https://tiles.openfreemap.org/styles/liberty",
    "datasetId": "spatial-dataset:openfreemap-liberty-runtime",
    "attribution": "OpenFreeMap © OpenMapTiles Data from OpenStreetMap"
  },
  "data": {
    "countries": "./data/world-countries.geojson",
    "aocAreas": "./data/france-appellations-aoc.geojson",
    "igpAreas": "./data/france-appellations-igp.geojson",
    "wineRegions": "./data/france-wine-regions.geojson",
    "searchIndex": "./data/search-index.json",
    "atlasGuides": "./data/atlas-guides.json",
    "atlasSubjects": "./data/atlas-subjects.json",
    "atlasEditorial": "./data/atlas-editorial.json",
    "entryPoints": "./data/atlas-entry-points.json",
    "producerPoints": "./data/atlas-producers.geojson",
    "provenance": "./data/provenance.json",
    "terrain": "./data/atlas-terrain.json",
    "terrainHillshade": "./data/atlas-terrain-hillshade.png",
    "terrainContours": "./data/atlas-terrain-contours.geojson"
  },
  "countries": {
    "france": {
      "cartaEntityId": "place:france",
      "bounds": [-5.6, 41.15, 10.1, 51.35],
      "maxZoom": 6.1
    }
  },
  "semanticZoom": {
    "wineRegionsMin": 4.3,
    "wineRegionsMax": 8.2,
    "producerClustersMin": 5.6,
    "producerPointsMin": 8.1,
    "appellationFillMin": 5.15,
    "appellationOutlineMin": 5.8,
    "appellationLabelMin": 8.6,
    "terrainMin": 6.2,
    "terrainFull": 7.4,
    "terrainFadeOut": 10.6,
    "terrainMax": 11.8,
    "contourIndexMin": 8.2,
    "contourIntermediateMin": 9.9,
    "contourMax": 12.4
  },
  "defaultLayers": {
    "aocAreas": true,
    "igpAreas": false,
    "wineRegions": true,
    "terrain": true
  },
  "humanReference": {
    "repositoryBaseUrl": "https://github.com/thatssoreg/carta/blob/main/"
  }
}
