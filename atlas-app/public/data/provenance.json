ution":"permitted_with_attribution","share_alike":false,"url":"https://documentation.dataspace.copernicus.eu/APIs/SentinelHub/Data/DEM/resources/license/License-COPDEM-30.pdf"},"measurement":{"native_resolution":"1 arc-second grid (3600×3600 samples per 1° tile); ≈30 m north–south and ≈20–23 m east–west across the acquired 42–48°N coverage","scale_limitations":"Usable for regional relief reading down to roughly 1:50,000. It cannot resolve an individual vineyard parcel, a terrace, a wall or a row orientation, and as a surface model it carries tree canopy and building heights as if they were ground.","uncertainty":"The programme specification is LE90 < 4 m vertical and CE90 < 6 m horizontal. The six western-Pyrenean source entries retain their separately checked tile-mask figures; no tile-mask precision beyond the programme specification is asserted for the two Beaujolais or two Loire files.","unit":"metre","variable":"surface_elevation","vertical_reference":"EGM2008 geoid (EPSG:3855)"},"product_class":"source_observation","publisher":"Copernicus programme — European Union and ESA (data © DLR e.V. and Airbus Defence and Space GmbH)","refresh_policy":"Pinned snapshot. CARTA re-acquires only when a Copernicus DEM release changes one of the ten governed files, or when an approved proof needs a bounded extent these four tile groups do not cover. Terrain is context, not a live feed, so there is no scheduled refresh.","resource_url":"https://copernicus-dem-30m.s3.amazonaws.com/","retrieved_at":"2026-08-30","source_release_date":"2022-05-09","transformations":[{"operation":"verify_pinned_source_files","order":1,"parameters":{"algorithm":"sha256","file_count":10,"refuse_on_mismatch":true}},{"operation":"mosaic_and_clip_source_observation","order":2,"parameters":{"clip_bbox_epsg4326":[-1.75,42.7,0.25,43.8],"clip_buffer_degrees":0.05,"extent_id":"bearn-jurancon","merge_resampling":"nearest","source_file_count":6}},{"operation":"reproject_to_display_grid","order":3,"parameters":