{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carta.local/schemas/geometry.schema.json",
  "title": "CARTA Geometry Metadata v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "entity_id", "geometry_ref", "geometry_type", "source_ids", "confidence", "precision"],
  "properties": {
    "id": {"type": "string", "pattern": "^geom:[a-z0-9][a-z0-9._-]*$"},
    "entity_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._-]*$"},
    "geometry_ref": {"type": "string", "minLength": 1},
    "geometry_type": {"enum": ["Point", "MultiPoint", "LineString", "MultiLineString", "Polygon", "MultiPolygon"]},
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^source:[a-z0-9][a-z0-9._-]*$"},
      "uniqueItems": true
    },
    "confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "precision": {"enum": ["surveyed", "official_boundary", "parcel", "address", "locality", "regional", "approximate", "unknown"]},
    "valid_from": {"type": ["string", "null"], "format": "date"},
    "valid_to": {"type": ["string", "null"], "format": "date"},
    "observed_at": {"type": ["string", "null"], "format": "date"},
    "notes": {"type": "string"}
  }
}
