{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carta.local/schemas/reference-profile.schema.json",
  "title": "CARTA Human Reference Profile v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "profile_kind", "component_entity_ids", "maturity", "publication_status"],
  "properties": {
    "id": {"type": "string", "pattern": "^profile:[a-z0-9][a-z0-9._-]*$"},
    "title": {"type": "string", "minLength": 1},
    "profile_kind": {
      "enum": ["producer", "grape", "country", "region", "appellation", "landscape", "ecosystem", "wine", "person", "institution", "practice", "classification", "historical_event"]
    },
    "primary_entity_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._-]*$"},
    "component_entity_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._-]*$"},
      "uniqueItems": true
    },
    "maturity": {"enum": ["node", "baseline", "deep"]},
    "publication_status": {"enum": ["published", "stub", "queued", "machine_only", "deprecated"]},
    "path": {"type": "string", "minLength": 1},
    "country_entity_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^place:[a-z0-9][a-z0-9._-]*$"},
      "uniqueItems": true
    },
    "representative_anchor_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._-]*$"},
      "uniqueItems": true
    },
    "research_gaps": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "notes": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"publication_status": {"const": "machine_only"}},
        "required": ["publication_status"]
      },
      "then": {"not": {"required": ["path"]}},
      "else": {"required": ["path"]}
    }
  ]
}
