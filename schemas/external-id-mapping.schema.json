{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carta.local/schemas/external-id-mapping.schema.json",
  "title": "CARTA External Geographic Identifier Mapping v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_system",
    "source_dataset_id",
    "source_object_type",
    "source_identifier",
    "source_name",
    "carta_entity_id",
    "match_status",
    "basis",
    "reviewed_at"
  ],
  "properties": {
    "source_system": {"type": "string", "minLength": 1},
    "source_dataset_id": {
      "type": "string",
      "pattern": "^spatial-dataset:[a-z0-9][a-z0-9._-]*$"
    },
    "source_object_type": {"type": "string", "minLength": 1},
    "source_identifier": {"type": "string", "minLength": 1},
    "source_name": {"type": "string", "minLength": 1},
    "carta_entity_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._-]*$"
    },
    "match_status": {"const": "accepted"},
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "reviewed_at": {"type": "string", "format": "date"},
    "notes": {"type": "string"}
  }
}
