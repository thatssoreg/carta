{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carta.local/schemas/entity.schema.json",
  "title": "CARTA Entity v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "name", "layer", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._-]*$"
    },
    "type": {
      "description": "Entity family. market_signal is retained for STRATA v0.2 compatibility but is deprecated for authored core data; Frontier intelligence is represented as dated claims on stable subjects.",
      "enum": [
        "person", "producer", "project", "ecosystem", "grape", "wine", "vineyard",
        "place", "appellation", "geographic_feature", "geology", "practice",
        "institution", "classification", "historical_event", "market_signal"
      ]
    },
    "name": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "layer": {"enum": ["reference", "frontier"]},
    "status": {"enum": ["active", "historical", "provisional", "contested", "deprecated"]},
    "place_kind": {
      "enum": [
        "country", "administrative_region", "cultural_region", "historical_territory",
        "municipality", "locality", "wine_region", "analytical_region", "other"
      ]
    },
    "alternate_names": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["synonym", "legal", "local", "historical", "trade", "translation", "other"]},
          "language": {"type": "string"},
          "jurisdiction": {"type": "string"},
          "valid_from": {"type": ["string", "null"], "format": "date"},
          "valid_to": {"type": ["string", "null"], "format": "date"},
          "notes": {"type": "string"}
        }
      }
    },
    "summary": {
      "type": "string",
      "description": "Non-authoritative display/search copy. Material facts require sourced claims."
    },
    "spatial_refs": {
      "deprecated": true,
      "description": "Deprecated authored reverse index. Derive spatial assertions from spatial-assertion.entity_id.",
      "type": "array",
      "items": {"type": "string", "pattern": "^(?:geom|spatial):[a-z0-9][a-z0-9._-]*$"},
      "uniqueItems": true
    },
    "name_assertion_ids": {
      "deprecated": true,
      "description": "Deprecated authored reverse index. Derive name assertions from name-assertion.entity_id.",
      "type": "array",
      "items": {"type": "string", "pattern": "^name:[a-z0-9][a-z0-9._-]*$"},
      "uniqueItems": true
    },
    "claim_ids": {
      "deprecated": true,
      "description": "Deprecated authored reverse index. Derive claims from claim.subject_ref. This does not deprecate forward evidence links on other record types.",
      "type": "array",
      "items": {"type": "string", "pattern": "^claim:[a-z0-9][a-z0-9._-]*$"},
      "uniqueItems": true
    },
    "tags": {
      "description": "Non-authoritative display, navigation, and search labels. Material facts require sourced claims.",
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
