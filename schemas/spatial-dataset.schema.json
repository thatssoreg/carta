{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carta.local/schemas/spatial-dataset.schema.json",
  "title": "CARTA Spatial Dataset Manifest v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source_id",
    "dataset_title",
    "publisher",
    "dataset_url",
    "resource_url",
    "retrieval_status",
    "license",
    "source_release_date",
    "retrieved_at",
    "checksum_algorithm",
    "checksum",
    "source_format",
    "source_crs",
    "geographic_meaning",
    "authority_class",
    "transformations",
    "derived_artifacts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^spatial-dataset:[a-z0-9][a-z0-9._-]*$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^source:[a-z0-9][a-z0-9._-]*$"
    },
    "dataset_title": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "dataset_url": {"type": "string", "format": "uri"},
    "resource_url": {"type": "string", "format": "uri"},
    "resource_id": {"type": ["string", "null"]},
    "retrieval_status": {"enum": ["acquired", "runtime_service", "derived_in_repository"]},
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "attribution_text",
        "commercial_use",
        "share_alike",
        "redistribution"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "attribution_text": {"type": "string", "minLength": 1},
        "commercial_use": {"type": "boolean"},
        "share_alike": {"type": "boolean"},
        "redistribution": {
          "enum": [
            "public_domain",
            "permitted_with_attribution",
            "runtime_service_subject_to_upstream_licenses"
          ]
        }
      }
    },
    "source_release_date": {"type": ["string", "null"], "format": "date"},
    "retrieved_at": {"type": "string", "format": "date"},
    "checksum_algorithm": {"type": ["string", "null"], "enum": ["sha256", null]},
    "checksum": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_format": {"type": "string", "minLength": 1},
    "source_crs": {"type": "string", "minLength": 1},
    "geographic_meaning": {"type": "string", "minLength": 1},
    "authority_class": {
      "enum": [
        "authoritative_regulatory",
        "institutional_geographic_context",
        "presentation_infrastructure"
      ]
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "operation", "parameters"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "operation": {"type": "string", "minLength": 1},
          "parameters": {"type": "object"}
        }
      }
    },
    "derived_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "format", "sha256", "bytes", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "feature_count": {"type": "integer", "minimum": 0},
          "record_count": {"type": "integer", "minimum": 0},
          "role": {"type": "string", "minLength": 1},
          "product_class": {"enum": ["derived_spatial_product", "modeled_environmental_product"]},
          "derived_from": {
            "description": "Spatial dataset IDs and/or sibling derived-artifact paths this artifact was produced from.",
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "pixel_width": {"type": "integer", "minimum": 1},
          "pixel_height": {"type": "integer", "minimum": 1}
        }
      }
    },
    "notes": {"type": "string"},
    "product_class": {
      "description": "Which tier of the CARTA environmental-data contract this dataset occupies. Interpretive wine knowledge is deliberately not expressible here: it lives in data/claims/ under the evidence policy. See docs/atlas-terrain-foundation.md.",
      "enum": ["source_observation", "derived_spatial_product", "modeled_environmental_product"]
    },
    "derived_from": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^spatial-dataset:[a-z0-9][a-z0-9._-]*$"}
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable", "unit", "native_resolution", "scale_limitations"],
      "properties": {
        "variable": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "vertical_reference": {"type": ["string", "null"]},
        "native_resolution": {"type": "string", "minLength": 1},
        "uncertainty": {"type": ["string", "null"]},
        "scale_limitations": {"type": "string", "minLength": 1}
      }
    },
    "geographic_extent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bbox_epsg4326", "description"],
      "properties": {
        "bbox_epsg4326": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number"}
        },
        "description": {"type": "string", "minLength": 1},
        "regions": {
          "description": "Optional explicit components when the source coverage is discontinuous; bbox_epsg4326 remains the outer envelope.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "bbox_epsg4326", "description"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
              "bbox_epsg4326": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {"type": "number"}
              },
              "description": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "resource_url", "sha256", "bytes"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "resource_url": {"type": "string", "format": "uri"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "notes": {"type": "string"}
        }
      }
    },
    "refresh_policy": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"retrieval_status": {"const": "acquired"}},
        "required": ["retrieval_status"]
      },
      "then": {
        "anyOf": [
          {
            "required": ["checksum"],
            "properties": {
              "checksum_algorithm": {"const": "sha256"},
              "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          },
          {
            "required": ["source_files"],
            "properties": {
              "checksum_algorithm": {"type": "null"},
              "checksum": {"type": "null"}
            }
          }
        ]
      },
      "else": {
        "properties": {
          "checksum_algorithm": {"type": "null"},
          "checksum": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "product_class": {"enum": ["derived_spatial_product", "modeled_environmental_product"]}
        },
        "required": ["product_class"]
      },
      "then": {"required": ["derived_from"]}
    }
  ]
}
